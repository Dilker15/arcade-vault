# Arcade Vault — variables de entorno
#
# Copia este archivo a .env.local y rellena los valores.
# .env.local está ignorado por git: nunca lo versiones.

# Clave de API de Resend (https://resend.com/api-keys).
# Obligatoria: sin ella, el formulario de /acerca-de devuelve la terminal de error.
RESEND_API_KEY=

# Buzón que recibe los mensajes del formulario de contacto.
# Obligatoria. Con el remitente de pruebas de Resend (ver abajo), solo se entrega
# a la dirección de correo de tu propia cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente del correo. Opcional: si se omite, se usa onboarding@resend.dev,
# el dominio de pruebas de Resend, que funciona sin verificar nada.
# Con un dominio propio ya verificado en Resend, pon aquí tu dirección.
CONTACT_FROM_EMAIL=onboarding@resend.dev


SUPABASE_DB_PASSWORD=
